                                    </DataTemplate>

                                </DataGridTemplateColumn.CellTemplate>

                            </DataGridTemplateColumn>

                        </DataGrid.Columns>

                    </DataGrid>

                </Border>

            </Grid>

        </DataTemplate>


        <!-- ========================= -->
        <!-- Driver Details -->
        <!-- ========================= -->

        <DataTemplate DataType="{x:Type local:DriverDetailsPageVm}">

            <ScrollViewer VerticalScrollBarVisibility="Auto">

                <StackPanel Margin="34">

                    <Grid Margin="0,0,0,18">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>

                            <TextBlock Text="تفاصيل المندوب"
                                       FontSize="30"
                                       FontWeight="SemiBold"/>

                            <TextBlock Text="{Binding Driver.Name}"
                                       Foreground="{StaticResource TextSecondary}"
                                       Margin="0,5,0,0"/>

                        </StackPanel>

                        <Button Grid.Column="1"
                                Content="رجوع"
                                Command="{Binding BackCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Width="90"/>

                    </Grid>

                    <UniformGrid Columns="4"
                                 Margin="0,0,0,16">

                        <Border Background="{StaticResource Surface}"
                                CornerRadius="12"
                                Padding="16"
                                Margin="0,0,8,0">

                            <StackPanel>

                                <TextBlock Text="إجمالي الأوردرات"
                                           Foreground="{StaticResource TextSecondary}"/>

                                <TextBlock Text="{Binding Driver.TotalOrders}"
                                           FontSize="25"
                                           FontWeight="Bold"/>

                            </StackPanel>

                        </Border>

                        <Border Background="{StaticResource Surface}"
                                CornerRadius="12"
                                Padding="16"
                                Margin="8,0">

                            <StackPanel>

                                <TextBlock Text="تم التسليم"
                                           Foreground="{StaticResource TextSecondary}"/>

                                <TextBlock Text="{Binding Driver.DeliveredOrders}"
                                           FontSize="25"
                                           FontWeight="Bold"/>

                            </StackPanel>

                        </Border>

                        <Border Background="{StaticResource Surface}"
                                CornerRadius="12"
                                Padding="16"
                                Margin="8,0">

                            <StackPanel>

                                <TextBlock Text="التحصيل"
                                           Foreground="{StaticResource TextSecondary}"/>

                                <TextBlock Text="{Binding Driver.CollectedAmount,StringFormat={}{0:N2} ج.م}"
                                           FontSize="20"
                                           FontWeight="Bold"/>

                            </StackPanel>

                        </Border>

                        <Border Background="{StaticResource Surface}"
                                CornerRadius="12"
                                Padding="16"
                                Margin="8,0,0,0">

                            <StackPanel>

                                <TextBlock Text="المستحق للمكتب"
                                           Foreground="{StaticResource TextSecondary}"/>

                                <TextBlock Text="{Binding Driver.AmountDueToOffice,StringFormat={}{0:N2} ج.م}"
                                           FontSize="20"
                                           FontWeight="Bold"
                                           Foreground="#60A5FA"/>

                            </StackPanel>

                        </Border>

                    </UniformGrid>

                    <Border Background="{StaticResource Surface}"
                            CornerRadius="14"
                            Padding="20"
                            Margin="0,0,0,16">

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>

                            <StackPanel>

                                <TextBlock Text="الهاتف"
                                           Foreground="{StaticResource TextSecondary}"/>

                                <TextBlock Text="{Binding Driver.Phone}"/>

                            </StackPanel>

                            <StackPanel Grid.Column="1">

                                <TextBlock Text="العنوان"
                                           Foreground="{StaticResource TextSecondary}"/>

                                <TextBlock Text="{Binding Driver.Address}"
                                           TextWrapping="Wrap"/>

                            </StackPanel>

                            <StackPanel Grid.Column="2">

                                <TextBlock Text="تاريخ البدء"
                                           Foreground="{StaticResource TextSecondary}"/>

                                <TextBlock Text="{Binding Driver.StartDate,StringFormat=dd/MM/yyyy}"/>

                            </StackPanel>

                        </Grid>

                    </Border>

                    <Border Background="{StaticResource Surface}"
                            CornerRadius="14"
                            Padding="18">

                        <StackPanel>

                            <Grid Margin="0,0,0,12">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel>

                                    <TextBlock Text="أوردرات المندوب"
                                               FontSize="19"
                                               FontWeight="SemiBold"/>

                                    <TextBlock Text="فلترة حسب الحالة والتاريخ"
                                               Foreground="{StaticResource TextSecondary}"/>

                                </StackPanel>

                                <ComboBox Grid.Column="1"
                                          Width="150"
                                          ItemsSource="{Binding StatusFilters}"
                                          SelectedItem="{Binding SelectedStatusFilter}"/>

                                <ComboBox Grid.Column="2"
                                          Width="150"
                                          ItemsSource="{Binding DateFilters}"
                                          SelectedItem="{Binding SelectedDateFilter}"/>

                            </Grid>

                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Left"
                                        Margin="0,0,0,12"
                                        Visibility="{Binding SelectedDateFilter,Converter={StaticResource StringEqualsVisibilityConverter},ConverterParameter=نطاق مخصص}">

                                <DatePicker SelectedDate="{Binding FromDate}"
                                            Width="150"/>

                                <DatePicker SelectedDate="{Binding ToDate}"
                                            Width="150"
                                            Margin="10,0,0,0"/>

                                <Button Content="تطبيق"
                                        Command="{Binding ApplyCustomDateRangeCommand}"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Width="80"/>

                            </StackPanel>

                            <DataGrid ItemsSource="{Binding Orders}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      Height="390">

                                <DataGrid.Columns>

                                    <DataGridTextColumn Header="رقم الأوردر"
                                                        Binding="{Binding OrderNumber}"
                                                        Width="1.1*"/>

                                    <DataGridTextColumn Header="التاريخ"
                                                        Binding="{Binding CreatedAt,StringFormat=dd/MM/yyyy}"
                                                        Width="1*"/>

                                    <DataGridTextColumn Header="العميل"
                                                        Binding="{Binding Customer.Name}"
                                                        Width="1.1*"/>

                                    <DataGridTextColumn Header="الهاتف"
                                                        Binding="{Binding PhoneSnapshot}"
                                                        Width="1*"/>

                                    <DataGridTextColumn Header="العنوان"
                                                        Binding="{Binding Address}"
                                                        Width="1.4*"/>

                                    <DataGridTextColumn Header="قيمة"
                                                        Binding="{Binding OrderValue,StringFormat={}{0:N2}}"
                                                        Width="0.8*"/>

                                    <DataGridTextColumn Header="التوصيل"
                                                        Binding="{Binding DeliveryFee,StringFormat={}{0:N2}}"
                                                        Width="0.8*"/>

                                    <DataGridTextColumn Header="الإجمالي"
                                                        Binding="{Binding TotalAmount,StringFormat={}{0:N2}}"
                                                        Width="0.8*"/>

                                    <DataGridTemplateColumn Header="الحالة"
                                                            Width="0.9*">

                                        <DataGridTemplateColumn.CellTemplate>

                                            <DataTemplate>

                                                <TextBlock Text="{Binding Status,Converter={StaticResource OrderStatusConverter}}"/>

                                            </DataTemplate>

                                        </DataGridTemplateColumn.CellTemplate>

                                    </DataGridTemplateColumn>

                                    <DataGridTextColumn Header="التحصيل"
                                                        Binding="{Binding CollectedAmount,StringFormat={}{0:N2}}"
                                                        Width="0.8*"/>

                                </DataGrid.Columns>

                            </DataGrid>

                        </StackPanel>

                    </Border>

                </StackPanel>

            </ScrollViewer>

        </DataTemplate>


        <!-- ========================= -->
        <!-- Customers -->
        <!-- ========================= -->

        <DataTemplate DataType="{x:Type local:CustomersPageVm}">

            <Grid Margin="34">

                <TextBlock Text="العملاء"
                           FontSize="30"
                           FontWeight="SemiBold"/>

                <Border Background="{StaticResource Surface}"
                        CornerRadius="14"
                        Padding="18"
                        Margin="0,55,0,0"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1">

                    <DataGrid ItemsSource="{Binding Parent.Customers}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True">

                        <DataGrid.Columns>

                            <DataGridTextColumn Header="الاسم"
                                                Binding="{Binding Name}"
                                                Width="1.2*"/>

                            <DataGridTextColumn Header="الهاتف"
                                                Binding="{Binding Phone}"
                                                Width="1*"/>

                            <DataGridTextColumn Header="العنوان"
                                                Binding="{Binding DefaultAddress}"
                                                Width="2*"/>

                            <DataGridTextColumn Header="عدد الطلبات"
                                                Binding="{Binding Orders.Count}"
                                                Width="1*"/>

                            <DataGridTextColumn Header="تاريخ الإضافة"
                                                Binding="{Binding CreatedAt,StringFormat=dd/MM/yyyy}"
                                                Width="1*"/>

                        </DataGrid.Columns>

                    </DataGrid>

                </Border>

            </Grid>

        </DataTemplate>


        <!-- ========================= -->
        <!-- Settlement -->
        <!-- ========================= -->

        <DataTemplate DataType="{x:Type local:SettlementPageVm}">

            <ScrollViewer VerticalScrollBarVisibility="Auto">

                <StackPanel Margin="34">

                    <TextBlock Text="التسويات المالية"
                               FontSize="30"
                               FontWeight="SemiBold"/>

                    <TextBlock Text="معاينة التسوية وحفظها مع منع التكرار"
                               Foreground="{StaticResource TextSecondary}"
                               Margin="0,5,0,24"/>

                    <Border Background="{StaticResource Surface}"
                            CornerRadius="14"
                            Padding="24"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1">

                        <StackPanel>

                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel>

                                    <TextBlock Text="المندوب"
                                               Foreground="{StaticResource TextSecondary}"/>

                                    <ComboBox ItemsSource="{Binding Drivers}"
                                              DisplayMemberPath="Name"
                                              TextSearch.TextPath="Name"
                                              SelectedItem="{Binding SelectedDriver}"/>

                                </StackPanel>

                                <StackPanel Grid.Column="1"
                                            Margin="12,0">

                                    <TextBlock Text="تاريخ التسوية"
                                               Foreground="{StaticResource TextSecondary}"/>

                                    <DatePicker SelectedDate="{Binding SelectedSettlementDate}"/>

                                </StackPanel>

                                <Button Grid.Column="2"
                                        Content="معاينة / مراجعة التسوية"
                                        Command="{Binding PreviewSettlementCommand}"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        VerticalAlignment="Bottom"
                                        Width="135"/>

                            </Grid>

                            <UniformGrid Columns="4"
                                         Margin="0,22,0,0">

                                <Border Background="#10182A"
                                        CornerRadius="10"
                                        Padding="16">

                                    <StackPanel>

                                        <TextBlock Text="عدد الأوردرات"
                                                   Foreground="{StaticResource TextSecondary}"/>

                                        <TextBlock Text="{Binding TotalOrders}"
                                                   FontSize="20"
                                                   FontWeight="SemiBold"/>

                                    </StackPanel>

                                </Border>

                                <Border Background="#10182A"
                                        CornerRadius="10"
                                        Padding="16"
                                        Margin="8,0">

                                    <StackPanel>

                                        <TextBlock Text="تم التسليم"
                                                   Foreground="{StaticResource TextSecondary}"/>

                                        <TextBlock Text="{Binding DeliveredOrders}"
                                                   FontSize="20"
                                                   FontWeight="SemiBold"/>

                                    </StackPanel>

                                </Border>

                                <Border Background="#10182A"
                                        CornerRadius="10"
                                        Padding="16"
                                        Margin="8,0">

                                    <StackPanel>

                                        <TextBlock Text="لم يتم التسليم"
                                                   Foreground="{StaticResource TextSecondary}"/>

                                        <TextBlock Text="{Binding FailedOrders}"
                                                   FontSize="20"
                                                   FontWeight="SemiBold"/>

                                    </StackPanel>

                                </Border>

                                <Border Background="#10182A"
                                        CornerRadius="10"
                                        Padding="16"
                                        Margin="8,0,0,0">

                                    <StackPanel>

                                        <TextBlock Text="مرتجع"
                                                   Foreground="{StaticResource TextSecondary}"/>

                                        <TextBlock Text="{Binding ReturnedOrders}"
                                                   FontSize="20"
                                                   FontWeight="SemiBold"/>

                                    </StackPanel>

                                </Border>

                            </UniformGrid>

                            <UniformGrid Columns="4"
                                         Margin="0,12,0,0">

                                <Border Background="#10182A"
                                        CornerRadius="10"
                                        Padding="16">

                                    <StackPanel>

                                        <TextBlock Text="التحصيل"
                                                   Foreground="{StaticResource TextSecondary}"/>

                                        <TextBlock Text="{Binding SettlementCalculation.Collected,StringFormat={}{0:N2} ج.م}"
                                                   FontSize="20"
                                                   FontWeight="SemiBold"/>

                                    </StackPanel>

                                </Border>

                                <Border Background="#10182A"
                                        CornerRadius="10"
                                        Padding="16"
                                        Margin="8,0">

                                    <StackPanel>

                                        <TextBlock Text="العمولة"
                                                   Foreground="{StaticResource TextSecondary}"/>

                                        <TextBlock Text="{Binding SettlementCalculation.Commission,StringFormat={}{0:N2} ج.م}"
                                                   FontSize="20"
                                                   FontWeight="SemiBold"/>

                                    </StackPanel>

                                </Border>

                                <Border Background="#10182A"
                                        CornerRadius="10"
                                        Padding="16"
                                        Margin="8,0">

                                    <StackPanel>

                                        <TextBlock Text="المصروفات"
                                                   Foreground="{StaticResource TextSecondary}"/>

                                        <TextBlock Text="{Binding SettlementCalculation.Expenses,StringFormat={}{0:N2} ج.م}"
                                                   FontSize="20"
                                                   FontWeight="SemiBold"/>

                                    </StackPanel>

                                </Border>

                                <Border Background="#10213D"
                                        CornerRadius="10"
                                        Padding="16"
                                        Margin="8,0,0,0">

                                    <StackPanel>

                                        <TextBlock Text="المطلوب للمكتب"
                                                   Foreground="{StaticResource TextSecondary}"/>

                                        <TextBlock Text="{Binding SettlementCalculation.Due,StringFormat={}{0:N2} ج.م}"
                                                   FontSize="20"
                                                   FontWeight="Bold"
                                                   Foreground="#60A5FA"/>

                                    </StackPanel>

                                </Border>

                            </UniformGrid>

                            <Grid Margin="0,18,0,0">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>

                                <StackPanel>

                                    <TextBlock Text="المبلغ المدفوع"
                                               Foreground="{StaticResource TextSecondary}"/>

                                    <TextBox Text="{Binding PaidAmount,UpdateSourceTrigger=PropertyChanged}"
                                             IsReadOnly="{Binding IsClosedSettlement}"/>

                                </StackPanel>

                                <StackPanel Grid.Column="1"
                                            Margin="10,0">

                                    <TextBlock Text="المتبقي"
                                               Foreground="{StaticResource TextSecondary}"/>

                                    <TextBlock Text="{Binding SettlementCalculation.Remaining,StringFormat={}{0:N2} ج.م}"
                                               FontSize="21"
                                               FontWeight="Bold"
                                               Foreground="#60A5FA"
                                               Margin="4,12,0,0"/>

                                </StackPanel>

                                <StackPanel Grid.Column="2"
                                            Margin="10,0">

                                    <TextBlock Text="ملاحظة"
                                               Foreground="{StaticResource TextSecondary}"/>

                                    <TextBox Text="{Binding SettlementNotes,UpdateSourceTrigger=PropertyChanged}"
                                             IsReadOnly="{Binding IsClosedSettlement}"/>

                                </StackPanel>

                            </Grid>

                            <TextBlock Text="{Binding Message}"
                                       Foreground="#60A5FA"
                                       TextWrapping="Wrap"
                                       Margin="0,12,0,0"
                                       FontWeight="SemiBold"/>

                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Left"
                                        Margin="0,16,0,0">

                                <Button Content="حفظ التسوية"
                                        Command="{Binding CreateSettlementCommand}"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Width="130"
                                        IsEnabled="{Binding IsClosedSettlement, Converter={StaticResource InverseBooleanConverter}}"/>

                            </StackPanel>

                        </StackPanel>

                    </Border>

                </StackPanel>

            </ScrollViewer>

        </DataTemplate>


