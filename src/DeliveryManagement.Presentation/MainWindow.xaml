                               FontWeight="SemiBold"/>

                    <TextBlock Text="أنشئ الطلب في أقل عدد من الخطوات"
                               Foreground="{StaticResource TextSecondary}"
                               Margin="0,5,0,24"/>

                    <Border Background="{StaticResource Surface}"
                            CornerRadius="14"
                            Padding="24"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1">

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0"
                                        Margin="0,0,10,12">

                                <TextBlock Text="اسم العميل"
                                           Foreground="{StaticResource TextSecondary}"/>

                                <TextBox Text="{Binding Parent.CustomerName,UpdateSourceTrigger=PropertyChanged}"/>

                            </StackPanel>

                            <StackPanel Grid.Row="0"
                                        Grid.Column="1"
                                        Margin="10,0">

                                <TextBlock Text="رقم الهاتف"
                                           Foreground="{StaticResource TextSecondary}"/>

                                <TextBox Text="{Binding Parent.CustomerPhone,UpdateSourceTrigger=PropertyChanged}"/>

                            </StackPanel>

                            <StackPanel Grid.Row="0"
                                        Grid.Column="2">

                                <TextBlock Text="المندوب"
                                           Foreground="{StaticResource TextSecondary}"/>

                                <ComboBox ItemsSource="{Binding Parent.Drivers}"
                                          DisplayMemberPath="Name"
                                          TextSearch.TextPath="Name"
                                          SelectedItem="{Binding Parent.SelectedDriver}"/>

                            </StackPanel>

                            <StackPanel Grid.Row="1"
                                        Grid.ColumnSpan="3">

                                <TextBlock Text="العنوان"
                                           Foreground="{StaticResource TextSecondary}"/>

                                <TextBox Text="{Binding Parent.CustomerAddress,UpdateSourceTrigger=PropertyChanged}"/>

                            </StackPanel>

                            <StackPanel Grid.Row="2"
                                        Margin="0,12,10,0">

                                <TextBlock Text="نوع الأوردر"
                                           Foreground="{StaticResource TextSecondary}"/>

                                <ComboBox ItemsSource="{Binding Parent.OrderTypeOptions}"
                                          DisplayMemberPath="Name"
                                          SelectedValuePath="Value"
                                          SelectedValue="{Binding Parent.SelectedType}"
                                          TextSearch.TextPath="Name"/>

                            </StackPanel>

                            <StackPanel Grid.Row="2"
                                        Grid.Column="1"
                                        Margin="10,12,10,0">

                                <TextBlock Text="قيمة الأوردر"
                                           Foreground="{StaticResource TextSecondary}"/>

                                <TextBox Text="{Binding Parent.OrderValue,UpdateSourceTrigger=PropertyChanged}"/>

                            </StackPanel>

                            <StackPanel Grid.Row="2"
                                        Grid.Column="2"
                                        Margin="10,12,0,0">

                                <TextBlock Text="رسوم التوصيل"
                                           Foreground="{StaticResource TextSecondary}"/>

                                <TextBox Text="{Binding Parent.DeliveryFee,UpdateSourceTrigger=PropertyChanged}"/>

                            </StackPanel>

                            <StackPanel Grid.Row="3"
                                        Margin="0,12,10,0">

                                <TextBlock Text="حالة الأوردر"
                                           Foreground="{StaticResource TextSecondary}"/>

                                <ComboBox ItemsSource="{Binding Parent.OrderStatusOptions}"
                                          DisplayMemberPath="Name"
                                          SelectedValuePath="Value"
                                          SelectedValue="{Binding Parent.SelectedStatus}"
                                          TextSearch.TextPath="Name"/>

                            </StackPanel>

                            <Border Grid.Row="3"
                                    Grid.Column="1"
                                    Background="#10213D"
                                    CornerRadius="10"
                                    Padding="18"
                                    Margin="10,12,10,0">

                                <Grid>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="الإجمالي"
                                               Foreground="{StaticResource TextSecondary}"/>

                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Parent.TotalOrderAmount,StringFormat={}{0:N2} ج.م}"
                                               FontSize="22"
                                               FontWeight="Bold"
                                               Foreground="#60A5FA"/>

                                </Grid>

                            </Border>

                            <StackPanel Grid.Row="4"
                                        Grid.ColumnSpan="3"
                                        Margin="0,12,0,0">

                                <TextBlock Text="ملاحظات"
                                           Foreground="{StaticResource TextSecondary}"/>

                                <TextBox Height="76"
                                         TextWrapping="Wrap"
                                         VerticalContentAlignment="Top"
                                         Padding="12"
                                         Text="{Binding Parent.OrderNotes,UpdateSourceTrigger=PropertyChanged}"/>

                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Left">

                                    <Button Content="حفظ الأوردر"
                                            Command="{Binding Parent.SaveOrderCommand}"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Width="135"/>

                                    <Button Content="مسح"
                                            Command="{Binding Parent.ClearOrderCommand}"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Width="85"/>

                                    <TextBlock Text="{Binding Parent.StatusMessage}"
                                               VerticalAlignment="Center"
                                               Foreground="#60A5FA"
                                               Margin="14,0,0,0"/>

                                </StackPanel>

                            </StackPanel>

                        </Grid>

                    </Border>

                </StackPanel>

            </ScrollViewer>

        </DataTemplate>


        <!-- ========================= -->
        <!-- Drivers -->
        <!-- ========================= -->

        <DataTemplate DataType="{x:Type local:DriversPageVm}">

            <Grid Margin="34">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid>

                    <StackPanel>

                        <TextBlock Text="المناديب"
                                   FontSize="30"
                                   FontWeight="SemiBold"/>

