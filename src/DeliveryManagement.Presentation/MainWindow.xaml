                                           HorizontalAlignment="Center"
                                           FontWeight="SemiBold"
                                           Margin="12,0"/>

                                <Button Grid.Column="3"
                                        Content="التالي"
                                        Command="{Binding Parent.NextOrdersPageCommand}"
