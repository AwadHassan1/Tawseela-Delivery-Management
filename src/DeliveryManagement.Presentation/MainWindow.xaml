        <!-- Info -->
        <!-- ========================= -->

        <!-- ========================= -->
        <!-- Reports -->
        <!-- ========================= -->

        <DataTemplate x:Key="ReportsTemplate">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="34">

                    <Grid Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="التقارير" FontSize="30" FontWeight="SemiBold"/>
                            <TextBlock Text="تقارير الأوردرات والتحصيل وأداء المناديب"
                                       Foreground="{StaticResource TextSecondary}" Margin="0,5,0,0"/>
                        </StackPanel>
                        <Button Content="↻  تحديث التقرير"
                                HorizontalAlignment="Left"
                                Command="{Binding LoadCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"
