                            <DataGridTextColumn Header="مع المندوب"
                                                Binding="{Binding AssignedOrders}"
                                                Width="0.8*"/>

                            <DataGridTextColumn Header="لم يتم"
                                                Binding="{Binding FailedOrders}"
                                                Width="0.8*"/>

                            <DataGridTextColumn Header="مرتجع"
