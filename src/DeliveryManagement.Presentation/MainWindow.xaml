                        </Border>

                    </Grid>

                </Border>

            </Grid>

        </DataTemplate>


        <!-- ========================= -->
        <!-- Add Order -->
        <!-- ========================= -->

        <DataTemplate DataType="{x:Type local:AddOrderPageVm}">

            <ScrollViewer VerticalScrollBarVisibility="Auto">

                <StackPanel Margin="34">

                    <TextBlock Text="إضافة أوردر جديد"
