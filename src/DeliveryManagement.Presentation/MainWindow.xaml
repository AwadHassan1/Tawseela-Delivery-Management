<Window x:Class="DeliveryManagement.Presentation.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DeliveryManagement.Presentation"
        Title="توصيله | إدارة الشحن والتوصيل"
        Width="1500"
        Height="900"
        MinWidth="1180"
        MinHeight="720"
        WindowStartupLocation="CenterScreen"
        FlowDirection="RightToLeft"
        Background="{StaticResource AppBackground}">

    <Window.Resources>
        <DataTemplate DataType="{x:Type local:ReportsPageVm}">
            <Grid Margin="25">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <StackPanel Grid.Row="0" Margin="0,0,0,20">
                    <TextBlock Text="التقارير"
                       FontSize="28"
                       FontWeight="Bold"/>

                    <TextBlock Text="تقارير وإحصائيات الطلبات والسائقين"
                       Margin="0,6,0,0"
                       Opacity="0.7"/>
                </StackPanel>

                <!-- Filters -->
                <Border Grid.Row="1"
                Padding="20"
                Margin="0,0,0,20"
                CornerRadius="12">

                    <StackPanel Orientation="Horizontal">

                        <StackPanel Margin="0,0,20,0">
                            <TextBlock Text="من تاريخ"/>
                            <DatePicker SelectedDate="{Binding FromDate}"/>
                        </StackPanel>

                        <StackPanel Margin="0,0,20,0">
                            <TextBlock Text="إلى تاريخ"/>
                            <DatePicker SelectedDate="{Binding ToDate}"/>
                        </StackPanel>

                        <Button Content="تحميل التقرير"
                        Command="{Binding LoadCommand}"
                        Padding="20,8"
                        Margin="0,20,10,0"/>

                        <Button Content="إعادة تعيين"
                        Command="{Binding ResetCommand}"
                        Padding="20,8"
                        Margin="0,20,0,0"/>

                        <Button Content="تصدير Excel"
                        Command="{Binding ExportExcelCommand}"
                        Padding="20,8"
                        Margin="10,20,0,0"
                        Style="{StaticResource SecondaryButtonStyle}"/>

                        <Button Content="تصدير PDF"
                        Command="{Binding ExportPdfCommand}"
                        Padding="20,8"
                        Margin="10,20,0,0"
                        Style="{StaticResource SecondaryButtonStyle}"/>

                        <Button Content="طباعة"
                        Command="{Binding PrintReportCommand}"
                        Padding="20,8"
                        Margin="10,20,0,0"
                        Style="{StaticResource PrimaryButtonStyle}"/>

                    </StackPanel>
                </Border>

                <!-- Report -->
                <ScrollViewer Grid.Row="2"
                      VerticalScrollBarVisibility="Auto">

                    <StackPanel>

                        <TextBlock Text="{Binding Message}"
                           Margin="0,0,0,15"/>

                        <UniformGrid Columns="5" Margin="0,0,0,20">

                            <Border Margin="5" Padding="15">
                                <StackPanel>
                                    <TextBlock Text="إجمالي الأوردرات"/>
                                    <TextBlock Text="{Binding TotalOrders}"
                                       FontSize="24"
                                       FontWeight="Bold"/>
                                </StackPanel>
                            </Border>

                            <Border Margin="5" Padding="15">
                                <StackPanel>
                                    <TextBlock Text="تم التوصيل"/>
                                    <TextBlock Text="{Binding DeliveredOrders}"
                                       FontSize="24"
                                       FontWeight="Bold"/>
                                </StackPanel>
                            </Border>

                            <Border Margin="5" Padding="15">
                                <StackPanel>
                                    <TextBlock Text="فشل"/>
                                    <TextBlock Text="{Binding FailedOrders}"
                                       FontSize="24"
                                       FontWeight="Bold"/>
                                </StackPanel>
                            </Border>

                            <Border Margin="5" Padding="15">
                                <StackPanel>
                                    <TextBlock Text="مرتجع"/>
                                    <TextBlock Text="{Binding ReturnedOrders}"
                                       FontSize="24"
                                       FontWeight="Bold"/>
                                </StackPanel>
                            </Border>

                            <Border Margin="5" Padding="15">
                                <StackPanel>
                                    <TextBlock Text="ملغي"/>
                                    <TextBlock Text="{Binding CancelledOrders}"
                                       FontSize="24"
                                       FontWeight="Bold"/>
                                </StackPanel>
                            </Border>

                        </UniformGrid>

                        <DataGrid ItemsSource="{Binding DriverRows}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True">

                            <DataGrid.Columns>

                                <DataGridTextColumn Header="السائق"
                                            Binding="{Binding DriverName}"/>

                                <DataGridTextColumn Header="الأوردرات"
                                            Binding="{Binding Orders}"/>

                                <DataGridTextColumn Header="تم التوصيل"
                                            Binding="{Binding Delivered}"/>

                                <DataGridTextColumn Header="فشل"
                                            Binding="{Binding Failed}"/>

                                <DataGridTextColumn Header="مرتجع"
                                            Binding="{Binding Returned}"/>

                                <DataGridTextColumn Header="قيمة الأوردرات"
                                            Binding="{Binding OrderValue}"/>

                                <DataGridTextColumn Header="رسوم التوصيل"
                                            Binding="{Binding DeliveryFees}"/>

                                <DataGridTextColumn Header="المحصل"
                                            Binding="{Binding Collected}"/>

                            </DataGrid.Columns>

                        </DataGrid>

                    </StackPanel>

                </ScrollViewer>

            </Grid>
        </DataTemplate>

        <!-- ========================= -->
        <!-- Dashboard -->
        <!-- ========================= -->

        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <DataTemplate DataType="{x:Type local:DashboardPageVm}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="34">

                    <!-- Header -->
                    <Grid Margin="0,0,0,24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="نظرة عامة"
                               FontSize="30"
                               FontWeight="SemiBold"/>

                            <TextBlock Text="متابعة أداء مكتب توصيله اليوم"
                               Foreground="{StaticResource TextSecondary}"
                               Margin="0,5,0,0"/>
                        </StackPanel>

                        <Button Grid.Column="1"
                        Content="＋  إضافة أوردر"
                        Command="{Binding Parent.NavigateCommand}"
                        CommandParameter="إضافة أوردر"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Width="155"/>
                    </Grid>

                    <!-- KPI Cards -->
                    <UniformGrid Columns="3"
                         Margin="0,0,0,18">

                        <Border Background="{StaticResource Surface}"
                        CornerRadius="14"
                        Margin="0,0,10,10"
                        Padding="20"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="أوردرات اليوم"
                                   Foreground="{StaticResource TextSecondary}"/>
                                <TextBlock Text="{Binding Parent.TodayOrders}"
                                   FontSize="30"
                                   FontWeight="SemiBold"
                                   Margin="0,8,0,0"/>
                                <TextBlock Text="إجمالي الطلبات اليوم"
                                   Foreground="{StaticResource TextSecondary}"
                                   FontSize="11"
                                   Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource Surface}"
                        CornerRadius="14"
                        Margin="10,0,10,10"
                        Padding="20"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="تم التسليم"
                                   Foreground="{StaticResource TextSecondary}"/>
                                <TextBlock Text="{Binding Parent.DeliveredOrders}"
                                   FontSize="30"
                                   FontWeight="SemiBold"
                                   Margin="0,8,0,0"/>
                                <TextBlock Text="طلبات مكتملة"
                                   Foreground="{StaticResource TextSecondary}"
                                   FontSize="11"
                                   Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource Surface}"
                        CornerRadius="14"
                        Margin="10,0,0,10"
                        Padding="20"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="المرتجعات"
                                   Foreground="{StaticResource TextSecondary}"/>
                                <TextBlock Text="{Binding Parent.ReturnedOrders}"
                                   FontSize="30"
                                   FontWeight="SemiBold"
                                   Margin="0,8,0,0"/>
                                <TextBlock Text="أوردرات مرتجعة"
                                   Foreground="{StaticResource TextSecondary}"
                                   FontSize="11"
                                   Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource Surface}"
                        CornerRadius="14"
                        Margin="0,10,10,0"
                        Padding="20"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="قيمة الأوردرات"
                                   Foreground="{StaticResource TextSecondary}"/>
                                <TextBlock Text="{Binding Parent.TodayRevenue,StringFormat={}{0:N2} ج.م}"
                                   FontSize="25"
                                   FontWeight="SemiBold"
                                   Margin="0,8,0,0"/>
                                <TextBlock Text="إجمالي قيمة الطلبات"
                                   Foreground="{StaticResource TextSecondary}"
                                   FontSize="11"
                                   Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource Surface}"
                        CornerRadius="14"
                        Margin="10,10,10,0"
                        Padding="20"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="رسوم التوصيل"
                                   Foreground="{StaticResource TextSecondary}"/>
                                <TextBlock Text="{Binding Parent.TodayFees,StringFormat={}{0:N2} ج.م}"
                                   FontSize="25"
                                   FontWeight="SemiBold"
                                   Margin="0,8,0,0"/>
                                <TextBlock Text="إجمالي رسوم التوصيل"
                                   Foreground="{StaticResource TextSecondary}"
                                   FontSize="11"
                                   Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#10213D"
                        CornerRadius="14"
                        Margin="10,10,0,0"
                        Padding="20"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="التحصيل"
                                   Foreground="{StaticResource TextSecondary}"/>
                                <TextBlock Text="{Binding Parent.TodayCollected,StringFormat={}{0:N2} ج.م}"
                                   FontSize="25"
                                   FontWeight="Bold"
                                   Foreground="#60A5FA"
                                   Margin="0,8,0,0"/>
                                <TextBlock Text="المبالغ المحصلة من الطلبات المسلمة"
                                   Foreground="{StaticResource TextSecondary}"
                                   FontSize="11"
                                   Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                    </UniformGrid>

                    <!-- Operations -->
                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.45*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Drivers -->
                        <Border Background="{StaticResource Surface}"
                        CornerRadius="14"
                        Padding="20"
                        Margin="0,0,10,0"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1">

                            <StackPanel>
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel>
                                        <TextBlock Text="أداء المناديب اليوم"
                                           FontSize="19"
                                           FontWeight="SemiBold"/>
                                        <TextBlock Text="متابعة الأوردرات حسب حالة كل مندوب"
                                           Foreground="{StaticResource TextSecondary}"
                                           Margin="0,5,0,0"/>
                                    </StackPanel>

                                    <Button Grid.Column="1"
                                    Content="عرض المناديب"
                                    Command="{Binding Parent.NavigateCommand}"
                                    CommandParameter="المناديب"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Width="105"/>
                                </Grid>

                                <DataGrid ItemsSource="{Binding Parent.DriverStatistics}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  Height="265">

                                    <DataGrid.Columns>

                                        <DataGridTextColumn Header="المندوب"
                                                    Binding="{Binding Name}"
                                                    Width="1.3*"/>

                                        <DataGridTextColumn Header="إجمالي"
                                                    Binding="{Binding TotalOrders}"
                                                    Width="0.7*"/>

                                        <DataGridTextColumn Header="تم التسليم"
                                                    Binding="{Binding DeliveredOrders}"
                                                    Width="0.8*"/>

                                        <DataGridTextColumn Header="جاري"
                                                    Binding="{Binding OutForDeliveryOrders}"
                                                    Width="0.7*"/>

                                        <DataGridTextColumn Header="مرتجع"
                                                    Binding="{Binding ReturnedOrders}"
                                                    Width="0.7*"/>

                                    </DataGrid.Columns>

                                </DataGrid>
                            </StackPanel>
                        </Border>

                        <!-- Daily Summary -->
                        <Border Grid.Column="1"
                        Background="{StaticResource Surface}"
                        CornerRadius="14"
                        Padding="20"
                        Margin="10,0,0,0"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1">

                            <StackPanel>
                                <TextBlock Text="ملخص اليوم"
                                   FontSize="19"
                                   FontWeight="SemiBold"/>

                                <TextBlock Text="رسوم التوصيل"
                                   Foreground="{StaticResource TextSecondary}"
                                   Margin="0,18,0,4"/>

                                <TextBlock Text="{Binding Parent.TodayFees,StringFormat={}{0:N2} ج.م}"
                                   FontSize="20"/>

                                <TextBlock Text="الأوردرات المرتجعة"
                                   Foreground="{StaticResource TextSecondary}"
                                   Margin="0,18,0,4"/>

                                <TextBlock Text="{Binding Parent.ReturnedOrders}"
                                   FontSize="20"/>

                                <TextBlock Text="التحصيل"
                                   Foreground="{StaticResource TextSecondary}"
                                   Margin="0,18,0,4"/>

                                <TextBlock Text="{Binding Parent.TodayCollected,StringFormat={}{0:N2} ج.م}"
                                   FontSize="20"
                                   FontWeight="SemiBold"/>

                                <Border Background="#122B22"
                                CornerRadius="10"
                                Padding="14"
                                Margin="0,18,0,0">

                                    <StackPanel>
                                        <TextBlock Text="● قاعدة البيانات متصلة"
                                           Foreground="#86EFAC"
                                           FontWeight="SemiBold"/>
                                        <TextBlock Text="النظام يعمل بشكل طبيعي"
                                           Foreground="#86EFAC"
                                           FontSize="11"
                                           Margin="0,4,0,0"/>
                                    </StackPanel>

                                </Border>

                                <TextBlock Text="وصول سريع"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Margin="0,20,0,10"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>

                                    <Button Content="الأوردرات"
                                    Command="{Binding Parent.NavigateCommand}"
                                    CommandParameter="الأوردرات"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Margin="0,0,5,0"/>

                                    <Button Grid.Column="1"
                                    Content="التسويات المالية"
                                    Command="{Binding Parent.NavigateCommand}"
                                    CommandParameter="التسويات المالية"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Margin="5,0,0,0"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                    </Grid>

                    <!-- Latest Orders -->
                    <Border Background="{StaticResource Surface}"
                    CornerRadius="14"
                    Padding="20"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1">

                        <StackPanel>

                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <TextBlock Text="آخر الأوردرات"
                                       FontSize="19"
                                       FontWeight="SemiBold"/>
                                    <TextBlock Text="آخر الطلبات المسجلة في النظام"
                                       Foreground="{StaticResource TextSecondary}"
                                       Margin="0,4,0,0"/>
                                </StackPanel>

                                <Button Grid.Column="1"
                                Content="عرض كل الأوردرات"
                                Command="{Binding Parent.NavigateCommand}"
                                CommandParameter="الأوردرات"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Width="125"/>
                            </Grid>

                            <DataGrid ItemsSource="{Binding Parent.LatestOrders}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              Height="300">

                                <DataGrid.Columns>

                                    <DataGridTextColumn Header="رقم الأوردر"
                                                Binding="{Binding OrderNumber}"
                                                Width="1.2*"/>

                                    <DataGridTextColumn Header="العميل"
                                                Binding="{Binding Customer.Name}"
                                                Width="1.2*"/>

                                    <DataGridTextColumn Header="المندوب"
                                                Binding="{Binding DeliveryMan.Name}"
                                                Width="1*"/>

                                    <DataGridTextColumn Header="الإجمالي"
                                                Binding="{Binding TotalAmount,StringFormat={}{0:N2}}"
                                                Width="0.8*"/>

                                    <DataGridTemplateColumn Header="الحالة"
                                                    Width="0.9*">

                                        <DataGridTemplateColumn.CellTemplate>

                                            <DataTemplate>

                                                <TextBlock Text="{Binding Status,Converter={StaticResource OrderStatusConverter}}"
                                                   HorizontalAlignment="Center"/>

                                            </DataTemplate>

                                        </DataGridTemplateColumn.CellTemplate>

                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Header="الفاتورة"
                                                    Width="0.8*">

                                        <DataGridTemplateColumn.CellTemplate>

                                            <DataTemplate>

                                                <Button Content="عرض"
                                                Command="{Binding DataContext.ShowInvoiceCommand,RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Height="32"
                                                Padding="10,0"/>

                                            </DataTemplate>

                                        </DataGridTemplateColumn.CellTemplate>

                                    </DataGridTemplateColumn>

                                </DataGrid.Columns>

                            </DataGrid>

                        </StackPanel>

                    </Border>

                </StackPanel>
            </ScrollViewer>
        </DataTemplate>

        <!-- ========================= -->
        <!-- Orders -->
        <!-- ========================= -->

        <DataTemplate DataType="{x:Type local:OrdersPageVm}">

            <Grid Margin="34">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid>

                    <StackPanel>

                        <TextBlock Text="الأوردرات"
                                   FontSize="30"
                                   FontWeight="SemiBold"/>

                        <TextBlock Text="إدارة ومتابعة جميع الطلبات"
                                   Foreground="{StaticResource TextSecondary}"
                                   Margin="0,5,0,0"/>

                    </StackPanel>

                    <Button Content="＋  إضافة أوردر"
                            HorizontalAlignment="Left"
                            Command="{Binding Parent.NavigateCommand}"
                            CommandParameter="إضافة أوردر"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Width="150"/>

                </Grid>

                <Border Grid.Row="1"
        Background="{StaticResource Surface}"
        CornerRadius="12"
        Padding="14"
        Margin="0,24,0,16"
        BorderBrush="{StaticResource BorderBrush}"
        BorderThickness="1">

                    <Grid>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Search -->
                        <Grid Grid.Row="0">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBox Grid.Column="0"
                     Height="42"
                     Margin="0,0,10,0"
                     Text="{Binding Parent.SearchText,UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="ابحث برقم الأوردر أو اسم العميل أو الهاتف أو المندوب"/>

                            <Button Grid.Column="1"
                    Content="🔍  بحث"
                    Command="{Binding Parent.SearchOrdersCommand}"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Width="95"
                    Margin="0,0,8,0"/>

                            <Button Grid.Column="2"
                    Content="↻  تحديث"
                    Command="{Binding Parent.RefreshOrdersCommand}"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Width="95"
                    Margin="0,0,8,0"/>

                            <Button Grid.Column="3"
                    Content="✕  مسح"
                    Command="{Binding Parent.ClearOrderFiltersCommand}"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Width="95"/>

                        </Grid>

                        <!-- Filters -->
                        <Grid Grid.Row="1"
              Margin="0,12,0,0">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Status -->
                            <TextBlock Grid.Column="0"
                       Text="الحالة:"
                       VerticalAlignment="Center"
                       Foreground="{StaticResource TextSecondary}"
                       Margin="0,0,8,0"/>

                            <ComboBox Grid.Column="1"
                      Height="38"
                      ItemsSource="{Binding Parent.OrderStatusFilterOptions}"
                      DisplayMemberPath="Name"
                      SelectedValuePath="Value"
                      SelectedValue="{Binding Parent.SelectedOrderStatusFilter}"/>

                            <!-- Driver -->
                            <TextBlock Grid.Column="2"
                       Text="المندوب:"
                       VerticalAlignment="Center"
                       Foreground="{StaticResource TextSecondary}"
                       Margin="20,0,8,0"/>

                            <ComboBox Grid.Column="3"
                      Height="38"
                      ItemsSource="{Binding Parent.Drivers}"
                      DisplayMemberPath="Name"
                      SelectedItem="{Binding Parent.SelectedOrderDriverFilter}"/>

                        </Grid>

                    </Grid>

                </Border>

                <Border Grid.Row="2"
                        Background="{StaticResource Surface}"
                        CornerRadius="14"
                        Padding="18"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1">

                    <Grid>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <DataGrid Grid.Row="0"
                                  ItemsSource="{Binding Parent.LatestOrders}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False">

                            <DataGrid.Columns>

                                <DataGridTextColumn Header="رقم الأوردر"
                                                    Binding="{Binding OrderNumber}"
                                                    Width="1.2*"/>

                                <DataGridTextColumn Header="التاريخ"
                                                    Binding="{Binding CreatedAt,StringFormat=dd/MM/yyyy HH:mm}"
                                                    Width="1.2*"/>

                                <DataGridTextColumn Header="العميل"
                                                    Binding="{Binding Customer.Name}"
                                                    Width="1.2*"/>

                                <DataGridTextColumn Header="الهاتف"
                                                    Binding="{Binding PhoneSnapshot}"
                                                    Width="1.1*"/>

                                <DataGridTextColumn Header="العنوان"
                                                    Binding="{Binding Address}"
                                                    Width="1.5*"/>

                                <DataGridTemplateColumn Header="النوع"
                                                        Width="0.9*">

                                    <DataGridTemplateColumn.CellTemplate>

                                        <DataTemplate>

                                            <TextBlock Text="{Binding Type,Converter={StaticResource OrderTypeConverter}}"
                                                       HorizontalAlignment="Center"/>

                                        </DataTemplate>

                                    </DataGridTemplateColumn.CellTemplate>

                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="الإجمالي"
                                                    Binding="{Binding TotalAmount,StringFormat={}{0:N2}}"
                                                    Width="0.9*"/>

                                <DataGridTextColumn Header="المندوب"
                                                    Binding="{Binding DeliveryMan.Name}"
                                                    Width="1*"/>

                                <DataGridTemplateColumn Header="الحالة"
                                                        Width="1.25*">

                                    <DataGridTemplateColumn.CellTemplate>

                                        <DataTemplate>

                                            <ComboBox ItemsSource="{Binding DataContext.OrderStatusOptions,
                                                                       RelativeSource={RelativeSource AncestorType=Window}}"
                                                      DisplayMemberPath="Name"
                                                      SelectedValuePath="Value"
                                                      SelectedValue="{Binding Status, Mode=OneWay}"
                                                      Tag="{Binding}"
                                                      DropDownClosed="OrderStatusComboBox_DropDownClosed"
                                                      HorizontalAlignment="Stretch"
                                                      MinWidth="120"/>

                                        </DataTemplate>

                                    </DataGridTemplateColumn.CellTemplate>

                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="الفاتورة"
                                                        Width="0.8*">

                                    <DataGridTemplateColumn.CellTemplate>

                                        <DataTemplate>

                                            <Button Content="عرض"
                                                    Command="{Binding DataContext.ShowInvoiceCommand,RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                    Height="32"
                                                    Padding="10,0"/>

                                        </DataTemplate>

                                    </DataGridTemplateColumn.CellTemplate>

                                </DataGridTemplateColumn>

                            </DataGrid.Columns>

                        </DataGrid>

                        <Border Grid.Row="1"
                                Background="#10182A"
                                CornerRadius="10"
                                Padding="10"
                                Margin="0,12,0,0">

                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="1"
                                        Content="السابق"
                                        Command="{Binding Parent.PreviousOrdersPageCommand}"
